<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.smartdns</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/smartdns</string>
        <string>-config</string>
        <string>/usr/local/etc/smartdns.yaml</string>
    </array>

    <!-- порт 53 требует root; LaunchDaemons как раз запускаются от root -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/smartdns.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/smartdns.log</string>
</dict>
</plist>
